+++ b/scripts/verification/session-branch-workflow.ts
@@ -0,0 +1,91 @@
+#!/usr/bin/env bun
+/** V12: real SessionManager/Host/storage; provider and pool endpoints are controlled ports. */
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { verificationWorkflow } from './verification-artifacts'
+
+await verificationWorkflow('session-branch', async evidence => {
+  const fixture = mkdtempSync(join(tmpdir(), 'phaneris-branch-workflow-'))
+  process.env.PHANERIS_CONFIG_DIR = join(fixture, 'config')
+  const { saveConfig } = await import('../../packages/shared/src/config/storage')
+  const { createWorkspaceAtPath } = await import('../../packages/shared/src/workspaces/storage')
+  const { createSession, loadSession, saveSession, getSessionPath } = await import('../../packages/shared/src/sessions/storage')
+  const { SessionManager } = await import('../../packages/server-core/src/sessions/SessionManager')
+  const { PiRuntimeDriver } = await import('../../packages/server-core/src/runtime-adapters/pi-driver')
+  const { createDurableRuntime } = await import('../../packages/server-core/src/durable-runtime')
+  const ws = join(fixture, 'workspace')
+  mkdirSync(ws, { recursive: true })
+  const workspace = { id: 'branch-fixture', slug: 'branch-fixture', createdAt: 1, name: 'Branch fixture', rootPath: ws }
+  createWorkspaceAtPath(ws, workspace.name, { permissionMode: 'ask' })
+  saveConfig({ workspaces: [workspace], activeWorkspaceId: workspace.id, activeSessionId: null })
+  const parent = await createSession(ws, { name: 'Parent', model: 'pi/gpt-5', permissionMode: 'ask' })
+  const storedParent = loadSession(ws, parent.id)
+  assert(storedParent, 'Parent must exist in real storage before branching')
+  await saveSession({ ...storedParent, sdkSessionId: 'fixture-parent-sdk', messages: [
+    { id: 'm1', type: 'user', content: 'Original parent input', timestamp: 1 },
+    { id: 'm2', type: 'assistant', content: 'Original parent answer', timestamp: 2 },
+  ] })
+  const sdkless = await createSession(ws, { name: 'Parent without SDK context', model: 'pi/gpt-5', permissionMode: 'ask' })
+  const storedSdkless = loadSession(ws, sdkless.id)
+  assert(storedSdkless)
+  await saveSession({ ...storedSdkless, messages: [{ id: 'm1', type: 'user', content: 'No SDK context', timestamp: 1 }] })
+  const parentFile = join(getSessionPath(ws, parent.id), 'session.jsonl')
+  const parentHash = () => createHash('sha256').update(readFileSync(parentFile)).digest('hex')
+  const before = parentHash(), checks: { id: string; passed: boolean; childId: string; disposed: boolean;
+    poolStopped: boolean; mcpDisconnected: boolean; hostGeneration: number | null }[] = []
+  const runtime = createDurableRuntime(), manager = new SessionManager(runtime)
+  const port = manager as unknown as { getOrCreateAgent: (managed: { id: string; poolServer?: { stop: () => Promise<void> }; mcpPool?: { disconnectAll: () => Promise<void> } }) => Promise<unknown> }
+  let failing = true, disposed = false, poolStopped = false, mcpDisconnected = false, childId = ''
+  let childView: ReturnType<typeof runtime.execution.view> | undefined
+  const record = (id: string) => checks.push({ id, passed: true, childId, disposed, poolStopped, mcpDisconnected,
+    hostGeneration: childView?.generation ?? null })
+  port.getOrCreateAgent = async managed => {
+    childId = managed.id
+    managed.poolServer = { stop: async () => { poolStopped = true } }
+    managed.mcpPool = { disconnectAll: async () => { mcpDisconnected = true } }
+    const backend = { supportsBranching: true, ensureBranchReady: async () => { if (failing) throw new Error('fixture preflight failed') },
+      destroy: () => { disposed = true } }
+    runtime.execution.installDriver(managed.id, new PiRuntimeDriver(backend as never))
+    childView = runtime.execution.view(managed.id)
+    return backend
+  }
+  try {
+    const beforeMissing = readdirSync(join(ws, 'sessions')).sort()
+    const sdklessFile = join(getSessionPath(ws, sdkless.id), 'session.jsonl')
+    const sdklessBefore = createHash('sha256').update(readFileSync(sdklessFile)).digest('hex')
+    await assert.rejects(manager.createSession(workspace.id, { branchFromSessionId: sdkless.id, branchFromMessageId: 'm1' }), /parent session SDK context is not initialized/)
+    assert.equal(childId, '', 'Invalid parent must be rejected before creating a driver')
+    assert.deepEqual(readdirSync(join(ws, 'sessions')).sort(), beforeMissing)
+    assert.equal(createHash('sha256').update(readFileSync(sdklessFile)).digest('hex'), sdklessBefore)
+    assert.equal(parentHash(), before)
+    record('missing-parent-sdk')
+    await assert.rejects(manager.createSession(workspace.id, { name: 'Failed branch', branchFromSessionId: parent.id, branchFromMessageId: 'm1' }), /fixture preflight failed/)
+    assert(disposed && poolStopped && mcpDisconnected, 'Branch failure must release Host driver and both pool endpoints')
+    assert.equal(childView?.driver, null)
+    assert(childView && childView.generation > 0, 'Failure rollback must release the Host session, not just drop its driver')
+    assert(!existsSync(getSessionPath(ws, childId)), 'Failed child must be deleted from real storage')
+    assert.equal(parentHash(), before)
+    record('preflight-rollback')
+    failing = false; disposed = false; poolStopped = false; mcpDisconnected = false
+    const branch = await manager.createSession(workspace.id, { name: 'Successful branch', branchFromSessionId: parent.id, branchFromMessageId: 'm1' })
+    assert(existsSync(getSessionPath(ws, branch.id)))
+    assert(runtime.execution.view(branch.id).driver, 'Successful branch remains owned by Host')
+    assert.equal(parentHash(), before)
+    record('successful-preflight')
+    await manager.deleteSession(branch.id)
+    assert(disposed && poolStopped && mcpDisconnected)
+    assert.equal(childView?.driver, null)
+    assert(childView && childView.generation > 0)
+    assert(!existsSync(getSessionPath(ws, branch.id)))
+    assert.equal(parentHash(), before)
+    record('successful-branch-delete')
+    evidence.complete(checks.map(check => check.id), ['live Pi SDK branch initialization', 'native Windows/Linux filesystem'])
+  } finally {
+    await runtime.close()
+    evidence.json('session-branch.json', { fixture, checks, parentUnchanged: parentHash() === before, parentSha256: before })
+  }
+  console.log(JSON.stringify({ passed: checks.length, output: join(evidence.directory, 'session-branch.json') }))
+})
diff --git a/scripts/verification/verification-artifacts.ts b/scripts/verification/verification-artifacts.ts
new file mode 100644
index 00000000..3354ac1a
--- /dev/null
+++ b/scripts/verification/verification-artifacts.ts
@@ -0,0 +1,126 @@
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { execFileSync, spawnSync } from 'node:child_process'
+import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { arch, release } from 'node:os'
+import { dirname, isAbsolute, join, relative, resolve } from 'node:path'
+
+const repository = resolve(import.meta.dir, '../..')
+const sha256 = (file: string) => createHash('sha256').update(readFileSync(file)).digest('hex')
+interface Artifact { path: string; sha256: string; bytes: number }
+export interface VerificationManifest {
+  schemaVersion: 1; workflow: string; sceneIds: string[]; passed: number; exitCode: number
+  artifacts: Artifact[]; untested: string[]
+  command: string[]; source: { headSha: string; lockfileSha256: string; dirty: boolean; dirtyPaths: string[] }
+  runtime: { bun: string; node: string | null; uv: string | null; platform: string; architecture: string }
+}
+
+function version(command: string, args: string[]) {
+  const result = spawnSync(command, args, { encoding: 'utf8' })
+  return result.status === 0 ? result.stdout.trim() : null
+}
+
+/** An explicit output is exclusive too: never overwrite an earlier run, even on failure. */
+export class VerificationRun {
+  readonly directory: string
+  readonly startedAt = new Date().toISOString()
+  private sceneIds: string[] = []
+  private untested: string[] = ['Windows/Linux native execution', 'live provider APIs', 'signed installer/release']
+  private readonly source = {
+    headSha: execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repository, encoding: 'utf8' }).trim(),
+    dirtyPaths: execFileSync('git', ['status', '--porcelain', '--untracked-files=all'], { cwd: repository, encoding: 'utf8' }).trim().split('\n').filter(Boolean),
+    lockfileSha256: sha256(join(repository, 'bun.lock')),
+    changedFiles: [...new Set([
+      ...execFileSync('git', ['diff', '--name-only', '-z', 'HEAD'], { cwd: repository }).toString().split('\0'),
+      ...execFileSync('git', ['ls-files', '--others', '--exclude-standard', '-z'], { cwd: repository }).toString().split('\0'),
+    ].filter(Boolean))].sort().map(path => ({ path, sha256: existsSync(join(repository, path)) ? sha256(join(repository, path)) : null })),
+  }
+  constructor(readonly workflow: string, readonly args = process.argv.slice(2)) {
+    const position = args.indexOf('--output-dir')
+    const explicit = args.find(arg => arg.startsWith('--output-dir='))?.slice('--output-dir='.length)
+      ?? (position >= 0 ? args[position + 1] : undefined)
+    const parent = join(repository, '.cache/verification')
+    mkdirSync(parent, { recursive: true })
+    if (explicit) {
+      this.directory = resolve(explicit)
+      mkdirSync(dirname(this.directory), { recursive: true })
+      mkdirSync(this.directory) // EEXIST is intentional; mkdir must claim the run atomically.
+    } else this.directory = mkdtempSync(join(parent, `${workflow}-`))
+  }
+  checkArguments(allowed: string[] = []) {
+    const args = [...this.args]
+    for (let index = 0; index < args.length; index++) {
+      const argument = args[index]!
+      if (argument === '--output-dir') {
+        assert(args[++index] && !args[index]!.startsWith('--'), '--output-dir requires a directory')
+      } else if (argument.startsWith('--output-dir=')) assert(argument.slice('--output-dir='.length), '--output-dir requires a directory')
+      else assert(allowed.includes(argument), `Unknown verification argument: ${argument}`)
+    }
+  }
+  json(name: string, value: unknown) { writeFileSync(join(this.directory, name), JSON.stringify(value, null, 2) + '\n') }
+  complete(sceneIds: string[], untested = this.untested) {
+    assert(sceneIds.length > 0 && new Set(sceneIds).size === sceneIds.length, 'Verification must execute nonzero, distinct scenes')
+    this.sceneIds = sceneIds
+    this.untested = untested
+  }
+  finish(error?: unknown) {
+    if (!error && !this.sceneIds.length) error = new Error('Workflow returned without completing any scenes')
+    if (error) this.json('failure.json', { message: error instanceof Error ? error.message : String(error),
+      stack: error instanceof Error ? error.stack : undefined })
+    const files = readdirSync(this.directory, { recursive: true, withFileTypes: true })
+      .filter(entry => entry.isFile() && join(entry.parentPath, entry.name) !== join(this.directory, 'manifest.json'))
+      .map(entry => join(entry.parentPath, entry.name)).sort()
+    this.json('manifest.json', { schemaVersion: 1, workflow: this.workflow, startedAt: this.startedAt, finishedAt: new Date().toISOString(),
+      command: process.argv, source: { ...this.source, dirty: this.source.dirtyPaths.length > 0 },
+      runtime: { bun: Bun.version, node: version('node', ['--version']), uv: version('uv', ['--version']),
+        platform: process.platform, architecture: arch(), osRelease: release(), executable: process.execPath },
+      sceneIds: this.sceneIds, passed: this.sceneIds.length, exitCode: error ? 1 : 0,
+      artifacts: files.map(file => ({ path: relative(this.directory, file).replaceAll('\\', '/'), sha256: sha256(file), bytes: readFileSync(file).byteLength })),
+      untested: this.untested,
+    })
+    if (error) throw error
+  }
+}
+
+export async function verificationWorkflow(workflow: string, execute: (run: VerificationRun) => Promise<void>) {
+  const run = new VerificationRun(workflow)
+  let failure: unknown
+  try { run.checkArguments(); await execute(run) } catch (error) { failure = error }
+  run.finish(failure)
+}
+
+export function verifyVerificationDirectory(directory: string, expected?: { workflow: string; minimum: number; required?: readonly string[] }) {
+  const manifest = JSON.parse(readFileSync(join(directory, 'manifest.json'), 'utf8')) as VerificationManifest
+  assert.equal(manifest.schemaVersion, 1)
+  assert.equal(manifest.exitCode, 0, 'Verification run failed')
+  assert(/^[a-f0-9]{40}$/.test(manifest.source.headSha), 'Missing source HEAD')
+  assert(/^[a-f0-9]{64}$/.test(manifest.source.lockfileSha256), 'Missing lockfile identity')
+  assert(typeof manifest.source.dirty === 'boolean' && Array.isArray(manifest.source.dirtyPaths))
+  assert(manifest.command.length > 0 && manifest.runtime.bun && manifest.runtime.platform && manifest.runtime.architecture)
+  assert(Array.isArray(manifest.untested), 'Unverified scope must be recorded')
+  assert(Array.isArray(manifest.sceneIds) && manifest.sceneIds.length > 0, 'No verified scenes')
+  assert.equal(new Set(manifest.sceneIds).size, manifest.sceneIds.length, 'Duplicate scene IDs')
+  assert.equal(manifest.passed, manifest.sceneIds.length)
+  if (expected) {
+    assert.equal(manifest.workflow, expected.workflow)
+    assert(manifest.passed >= expected.minimum, `Expected at least ${expected.minimum} verified scenes`)
+    for (const required of expected.required ?? []) assert(manifest.artifacts.some(artifact => artifact.path === required), `Unregistered required artifact: ${required}`)
+  }
+  assert(manifest.artifacts.length > 0, 'No verification artifacts')
+  assert.equal(new Set(manifest.artifacts.map(artifact => artifact.path)).size, manifest.artifacts.length)
+  for (const artifact of manifest.artifacts) {
+    assert(!isAbsolute(artifact.path) && !artifact.path.split(/[\\/]/).includes('..'), 'Artifact escapes its run directory')
+    const file = join(directory, artifact.path)
+    assert(existsSync(file), `Missing artifact: ${artifact.path}`)
+    assert.equal(sha256(file), artifact.sha256, `Artifact SHA-256 mismatch: ${artifact.path}`)
+    assert.equal(readFileSync(file).byteLength, artifact.bytes)
+  }
+  return manifest
+}
+
+if (import.meta.main) {
+  const directory = process.argv.slice(2).find(arg => arg.startsWith('--verify='))?.slice('--verify='.length)
+  assert(directory, 'Usage: bun run scripts/verification/verification-artifacts.ts --verify=<directory>')
+  const result = verifyVerificationDirectory(resolve(directory))
+  console.log(JSON.stringify({ passed: result.passed, workflow: result.workflow, output: resolve(directory) }))
+}
diff --git a/scripts/verification/verification-output-workflow.ts b/scripts/verification/verification-output-workflow.ts
new file mode 100644
index 00000000..ea7cd140
--- /dev/null
+++ b/scripts/verification/verification-output-workflow.ts
@@ -0,0 +1,74 @@
+#!/usr/bin/env bun
+/** V01–V07, written before the artifact isolation implementation. Runs the actual CLI workflows. */
+import assert from 'node:assert/strict'
+import { execFileSync } from 'node:child_process'
+import { createHash } from 'node:crypto'
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
+import { tmpdir } from 'node:os'
+import { verificationWorkflow } from './verification-artifacts'
+
+await verificationWorkflow('verification-output', async evidence => {
+const root = resolve(import.meta.dir, '../..'), parent = join(root, '.cache/verification')
+const output = evidence.directory, checks: { id: string; passed: boolean }[] = []
+const workflows = ['runtime-boundary-gate-workflow.ts', 'durable-runtime-boundary-workflow.ts', 'durable-runtime-crash-workflow.ts']
+const tracked = execFileSync('git', ['ls-files', '-z'], { cwd: root }).toString().split('\0').filter(Boolean)
+const hashes = () => Object.fromEntries(tracked.filter(file => existsSync(join(root, file))).map(file => [file, createHash('sha256').update(readFileSync(join(root, file))).digest('hex')]))
+const before = hashes()
+async function invoke(args: string[], expected = 0) {
+  const child = Bun.spawn([process.execPath, ...args], { cwd: root, stdout: 'pipe', stderr: 'pipe' })
+  const [stdout, stderr, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited])
+  assert.equal(code, expected, `${args.join(' ')}\n${stdout}\n${stderr}`)
+  return stdout
+}
+try {
+  const runs: string[] = []
+  for (let repeat = 0; repeat < 2; repeat++) for (const name of workflows) {
+    const stdout = await invoke(['run', `scripts/verification/${name}`])
+    const parsed = JSON.parse(stdout.trim().split('\n').at(-1)!)
+    const dir = dirname(parsed.output)
+    assert(dir.startsWith(parent))
+    runs.push(dir)
+    await invoke(['run', 'scripts/verification/verification-artifacts.ts', `--verify=${dir}`])
+  }
+  assert.equal(new Set(runs).size, 6)
+  checks.push({ id: 'V01', passed: true })
+  const concurrent = await Promise.all([0, 1].map(async () => {
+    const stdout = await invoke(['run', 'scripts/verification/durable-runtime-boundary-workflow.ts'])
+    return dirname(JSON.parse(stdout.trim().split('\n').at(-1)!).output)
+  }))
+  assert.notEqual(concurrent[0], concurrent[1])
+  for (const dir of concurrent) await invoke(['run', 'scripts/verification/verification-artifacts.ts', `--verify=${dir}`])
+  checks.push({ id: 'V02', passed: true })
+  const occupied = join(output, 'occupied'); mkdirSync(occupied); writeFileSync(join(occupied, 'sentinel'), 'preserve')
+  await invoke(['run', 'scripts/verification/runtime-boundary-gate-workflow.ts', `--output-dir=${occupied}`], 1)
+  assert.equal(readFileSync(join(occupied, 'sentinel'), 'utf8'), 'preserve')
+  checks.push({ id: 'V03', passed: true })
+  const corrupt = join(output, 'corrupt'); cpSync(runs[0]!, corrupt, { recursive: true })
+  const manifestPath = join(corrupt, 'manifest.json'), manifest = JSON.parse(readFileSync(manifestPath, 'utf8'))
+  writeFileSync(manifestPath, JSON.stringify({ ...manifest, passed: 0, sceneIds: [] }))
+  await invoke(['run', 'scripts/verification/verification-artifacts.ts', `--verify=${corrupt}`], 1)
+  checks.push({ id: 'V04', passed: true })
+  writeFileSync(manifestPath, JSON.stringify(manifest))
+  const artifact = join(corrupt, manifest.artifacts[0].path)
+  writeFileSync(artifact, 'tampered')
+  await invoke(['run', 'scripts/verification/verification-artifacts.ts', `--verify=${corrupt}`], 1)
+  rmSync(artifact)
+  await invoke(['run', 'scripts/verification/verification-artifacts.ts', `--verify=${corrupt}`], 1)
+  checks.push({ id: 'V05', passed: true })
+  const fixture = mkdtempSync(join(tmpdir(), 'phaneris-critical-preflight-'))
+  await invoke(['run', 'scripts/test-critical.ts', '--preflight', `--repository=${fixture}`], 1)
+  checks.push({ id: 'V06', passed: true })
+  const failed = join(output, 'failed')
+  await invoke(['run', 'scripts/verification/runtime-boundary-gate-workflow.ts', `--output-dir=${failed}`, '--unknown'], 1)
+  assert.equal(JSON.parse(readFileSync(join(failed, 'manifest.json'), 'utf8')).exitCode, 1)
+  assert(existsSync(join(failed, 'failure.json')))
+  checks.push({ id: 'V07', passed: true })
+  assert.deepEqual(hashes(), before, 'Default verification runs must not change tracked files')
+  evidence.complete(checks.map(check => check.id), ['GitHub Actions remote execution', 'native Windows/Linux execution'])
+} finally {
+  evidence.json('verification-output.json', { generatedAt: new Date().toISOString(), checks,
+    trackedFileCount: tracked.length, trackedHashesUnchanged: JSON.stringify(before) === JSON.stringify(hashes()) })
+  console.log(JSON.stringify({ output, passed: checks.length }))
+}
+})
