@echo off
set "PHANERIS_BUN_BIN=%PHANERIS_BUN%"
if "%PHANERIS_BUN_BIN%"=="" set "PHANERIS_BUN_BIN=bun"
set "PHANERIS_COMMANDS_BIN=%PHANERIS_COMMANDS_ENTRY%"
if "%PHANERIS_COMMANDS_BIN%"=="" set "PHANERIS_COMMANDS_BIN=%PHANERIS_CLI_ENTRY%"
if "%PHANERIS_CLI_JSON_ONLY%"=="" set "PHANERIS_CLI_JSON_ONLY=1"
set "ARGS="
:argloop
if "%~1"=="" goto :run
set "ARGS=%ARGS% "%~1""
shift
goto :argloop
:run
"%PHANERIS_BUN_BIN%" run "%PHANERIS_COMMANDS_BIN%"%ARGS%
