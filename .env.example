# Phaneris — environment configuration example
#
# Copy to .env and adjust. All variables are optional unless marked
# Required — the app works out of the box with source configs + Pi SDK
# connections (Settings → AI).
#
# Every variable this product reads uses the PHANERIS_ prefix. The upstream
# CRAFT_ names are NOT inherited: credentials, the data directory and the
# update feed in particular must never be picked up from the old application.
# Automations are the one exception — user-defined webhook secrets in your
# shell profile are still read under the old prefix for one transition, with a
# deprecation notice (see apps/electron/resources/docs/automations.md).

# ---------------------------------------------------------------------------
# Pi SDK backend (single backend since the Pi migration)
# ---------------------------------------------------------------------------
# LLM provider env vars read by the CLI (`apps/cli`) and Pi API-key flows.
# `pi` is the only providerType; piAuthProvider selects the model catalog
# (anthropic, openai, google, deepseek, openrouter, xai, kimi-coding, ...).
#LLM_PROVIDER=pi
#LLM_MODEL=claude-opus-4-8
#LLM_API_KEY=sk-...
#LLM_BASE_URL=https://api.anthropic.com/v1
#DEEPSEEK_API_KEY=sk-...
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Headless server mode
# ---------------------------------------------------------------------------
# Required when running the standalone server (packages/server).
# Generate one, e.g. `openssl rand -hex 24`:
#PHANERIS_SERVER_TOKEN=your-long-random-token
#PHANERIS_RPC_HOST=0.0.0.0
#PHANERIS_RPC_PORT=9100
# TLS (recommended for non-loopback binds; without TLS a non-loopback bind is refused):
#PHANERIS_RPC_TLS_CERT=/path/to/cert.pem
#PHANERIS_RPC_TLS_KEY=/path/to/key.pem
#PHANERIS_RPC_TLS_CA=/path/to/ca.pem
# Health endpoint port (0 disables):
#PHANERIS_HEALTH_PORT=9101
# Web UI + bundled assets (used by install-server.sh / server:dev):
#PHANERIS_WEBUI_DIR=./apps/webui/dist
#PHANERIS_BUNDLED_ASSETS_ROOT=./apps/electron
#PHANERIS_APP_ROOT=/abs/path/to/app-root
#PHANERIS_RESOURCES_PATH=/abs/path/to/resources
#PHANERIS_IS_PACKAGED=true
#PHANERIS_VERSION=0.13.3
# Optional shorter Web UI login password (falls back to PHANERIS_SERVER_TOKEN):
#PHANERIS_WEBUI_PASSWORD=
#PHANERIS_WEBUI_SECURE_COOKIE=true
# Public browser-facing WebSocket URL returned by /api/config:
#PHANERIS_WEBUI_WS_URL=wss://your-server:9100
# WhatsApp worker subprocess (default resolves under PHANERIS_BUNDLED_ASSETS_ROOT):
#PHANERIS_MESSAGING_WA_WORKER=/abs/path/to/worker.cjs
#PHANERIS_MESSAGING_NODE_BIN=node
#PHANERIS_DISABLE_MESSAGING=1
#PHANERIS_LOCAL_MCP_ENABLED=0

# Thin-client mode: point the desktop app at a remote server instead of
# running the embedded server locally.
#PHANERIS_SERVER_URL=wss://your-server:9100

# ---------------------------------------------------------------------------
# Paths & runtime
# ---------------------------------------------------------------------------
# Override the config/state directory (default ~/.phaneris):
#PHANERIS_CONFIG_DIR=~/.phaneris
# WeChat iLink transport state dir (default ~/.phaneris/wechat):
#PHANERIS_WECHAT_STATE_DIR=~/.phaneris/wechat
# Disable the global fetch interceptor (bun preload) for this process:
#PHANERIS_INTERCEPTOR_DISABLE_AUTO_INSTALL=1
# Debug logging (main/server/interceptor):
#PHANERIS_DEBUG=1

# ---------------------------------------------------------------------------
# OAuth providers (development fallbacks; production uses source configs)
# ---------------------------------------------------------------------------
# Google OAuth (Desktop app client; used when source config lacks credentials):
#GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
#GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Slack OAuth:
#SLACK_OAUTH_CLIENT_ID=your-slack-client-id
#SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret

# Microsoft OAuth (PKCE — no client_secret needed):
#MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id

# AWS (Bedrock model fetching / CLI S3 tooling):
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...
#AWS_REGION=us-east-1
#AWS_SESSION_TOKEN=...

# ---------------------------------------------------------------------------
# Error tracking
# ---------------------------------------------------------------------------
# Sentry ingest URL (captures crashes and chat/SDK errors):
# Crash reporting is opt-in; both a DSN and the explicit consent flag are required:
#PHANERIS_TELEMETRY_ENABLED=1
#SENTRY_ELECTRON_INGEST_URL=https://your-public-key@o0.ingest.sentry.io/0
#SENTRY_AUTH_TOKEN=...   # build-time sourcemap upload only

# ---------------------------------------------------------------------------
# Tuning knobs (defaults are sane — leave commented)
# ---------------------------------------------------------------------------
# Durable-runtime cutover flags (defaults are conservative):
#PHANERIS_DURABLE_SESSION_READ=1
#PHANERIS_DURABLE_SESSION_CANARY=1
#PHANERIS_TASK_RUN_TIMEOUT_MS=1800000   # TaskRunner wall-clock timeout (default 30 min)
#PHANERIS_TRANSFER_TTL_MS=300000        # session-transfer chunk TTL
#PHANERIS_BROWSER_OPEN_SETTLE_TIMEOUT_MS=5000
#PHANERIS_BROWSER_OPEN_SETTLE_POLL_MS=200
