{
  "name": "@phaneris/server",
  "version": "0.2.0",
  "description": "Standalone headless Phaneris server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "craft-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "VanDING"
  },
  "license": "Apache-2.0",
  "homepage": "https://thecraftagents.com",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "bun run tsc --noEmit"
  },
  "dependencies": {
    "@phaneris/core": "workspace:*",
    "@phaneris/messaging-gateway": "workspace:*",
    "@phaneris/server-core": "workspace:*",
    "@phaneris/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "ws": "8.21.3"
  }
}
