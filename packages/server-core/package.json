{
  "name": "@phaneris/server-core",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Reusable headless server infrastructure for Phaneris",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./transport/client": "./src/transport/client.ts",
    "./transport/codec": "./src/transport/codec.ts",
    "./transport/session-read-client": "./src/transport/session-read-client.ts",
    "./runtime": "./src/runtime/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./model-fetchers": "./src/model-fetchers/index.ts",
    "./domain": "./src/domain/index.ts",
    "./services": "./src/services/index.ts",
    "./handlers/rpc": "./src/handlers/rpc/index.ts",
    "./handlers/rpc/*": "./src/handlers/rpc/*.ts",
    "./sessions": "./src/sessions/index.ts",
    "./durable-runtime": "./src/durable-runtime/index.ts",
    "./tasks": "./src/tasks/index.ts",
    "./webui": "./src/webui/index.ts",
    "./handlers/rpc/server": "./src/handlers/rpc/server.ts"
  },
  "scripts": {
    "typecheck": "bun run tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@phaneris/core": "workspace:*",
    "@phaneris/session-tools-core": "workspace:*",
    "@phaneris/shared": "workspace:*",
    "heic-convert": "2.1.0",
    "jose": "^6.2.12",
    "markitdown-js": "^0.0.14",
    "openai": "^7.27.0",
    "sharp": "0.35.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/heic-convert": "2.1.1",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
