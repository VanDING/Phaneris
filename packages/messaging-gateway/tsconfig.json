{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "bun"],
    // Match the workspace packages' effective strictness (server-core/shared
    // do not enable noUncheckedIndexedAccess); keep the root's other checks.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "*": ["./*"],
      "@phaneris/shared": ["../shared/src/index.ts"],
      "@phaneris/shared/*": ["../shared/src/*"],
      "@phaneris/server-core": ["../server-core/src/index.ts"],
      "@phaneris/server-core/*": ["../server-core/src/*"]
    }
  },
  "include": ["src"]
}
