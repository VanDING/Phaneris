# =============================================================================
# Phaneris Server — multi-platform Docker image
#
# Build:
#   docker buildx build -f Dockerfile.server -t phaneris-server .
#
# Run (use --user to match host UID/GID for volume permissions):
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/phaneris \
#     -e PHANERIS_SERVER_TOKEN=<secret> \
#     phaneris-server
#
# Run with TLS + mounted config:
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/phaneris \
#     -e PHANERIS_SERVER_TOKEN=<secret> \
#     -e PHANERIS_RPC_TLS_CERT=/certs/cert.pem \
#     -e PHANERIS_RPC_TLS_KEY=/certs/key.pem \
#     -v /path/to/certs:/certs:ro \
#     -v ~/.phaneris:/home/phaneris/.phaneris \
#     phaneris-server
# =============================================================================

FROM oven/bun:1.4.2-slim

LABEL org.opencontainers.image.source="https://github.com/VanDING/Phaneris"
LABEL org.opencontainers.image.description="Phaneris Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install system deps + Node.js (required by the WhatsApp worker subprocess;
# Bun cannot run Baileys' crypto deps). Pin Node to a major via NodeSource so
# upgrades are explicit — must match the --target in scripts/build-wa-worker.ts.
# Node 20 reached end-of-life on 2026-04-30 and the Pi 1.0.0 SDK requires
# >=22.19.0, so the container tracks the Node 24 LTS line.
ARG NODE_MAJOR=24
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git ripgrep curl gnupg python3 make g++ && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user (Claude Code SDK refuses to run as root).
# At runtime, override with --user $(id -u):$(id -g) to match host permissions.
RUN groupadd -r phaneris && \
    useradd -r -g phaneris -m -d /home/phaneris -s /bin/bash phaneris

WORKDIR /app

# Copy dependency manifests first for layer caching.
# `bunfig.toml` MUST be in the WORKDIR before `bun install` runs — it sets
# `linker = "hoisted"`, which is required for the WebUI / renderer build
# (transitive deps like i18next, @tiptap/*, pdfjs-dist resolve at top-level
# node_modules). Without it Bun defaults to isolated installs and the Vite
# build fails on the first transitive bare-package import.
COPY package.json bun.lock bunfig.toml ./
COPY packages/server/package.json packages/server/
COPY packages/server-core/package.json packages/server-core/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/ui/package.json packages/ui/
COPY packages/messaging-gateway/package.json packages/messaging-gateway/
COPY packages/messaging-whatsapp-worker/package.json packages/messaging-whatsapp-worker/
COPY apps/electron/package.json apps/electron/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/
COPY apps/webui/package.json apps/webui/
COPY patches/ patches/

RUN bun install --frozen-lockfile

# Copy source
COPY . .

# The same Pi launcher and Node worker commands are used by standalone and desktop builds.
RUN bun run build:runtime && mkdir -p apps/electron/resources/pi-agent-server && \
    cp -R packages/pi-agent-server/dist/. apps/electron/resources/pi-agent-server/

# Build web UI assets (served by the server on the RPC port).
# vite's bundler runs under Node (via shebang in vite's bin) and hits V8's
# default ~2GB heap cap on the rendering phase (>5k modules). Raise to 4GB
# so low-RAM build hosts (e.g. 4GB VPS) can complete the build.
RUN NODE_OPTIONS="--max-old-space-size=4096" bunx vite build --config apps/webui/vite.config.ts

# Pre-create .phaneris so Docker named volumes inherit the correct permissions.
RUN mkdir -p /home/phaneris/.phaneris

# Make app world-readable so any --user can run it. Home dir is writable for .phaneris.
# Use find to only touch files/dirs missing the read bit — much faster than chmod -R on the
# entire tree (node_modules alone has hundreds of thousands of entries).
RUN find /app -not -perm -o=r -exec chmod o+r {} + && \
    find /app -type d -not -perm -o=x -exec chmod o+x {} + && \
    chmod -R 777 /home/phaneris

USER phaneris

ENV PHANERIS_RPC_HOST=0.0.0.0
ENV PHANERIS_IS_PACKAGED=true
ENV PHANERIS_RPC_PORT=9100
ENV PHANERIS_WEBUI_DIR=/app/apps/webui/dist
ENV PHANERIS_BUNDLED_ASSETS_ROOT=/app/apps/electron
ENV PHANERIS_RESOURCES_PATH=/app/apps/electron/resources
# WhatsApp worker — Bun cannot run the CJS worker, so we point the adapter at
# system `node` (installed above). If PHANERIS_BUNDLED_ASSETS_ROOT changes, update
# PHANERIS_MESSAGING_WA_WORKER to match; the default in packages/server resolves
# against PHANERIS_BUNDLED_ASSETS_ROOT, but the layout above flattens to /app.
ENV PHANERIS_MESSAGING_WA_WORKER=/app/packages/messaging-whatsapp-worker/dist/worker.cjs
ENV PHANERIS_MESSAGING_NODE_BIN=node

EXPOSE 9100

ENTRYPOINT ["bun", "run", "packages/server/src/index.ts"]
